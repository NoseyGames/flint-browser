{
  "manifest_version": 3,
  "name": "Flint",
  "version": "1.0.0",
  "description": "Flint’s local start page and privacy controls.",
  "key": "",
  "permissions": ["search", "declarativeNetRequest"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": {
    "default_title": "Flint privacy",
    "default_popup": "privacy/popup.html",
    "default_icon": { "16": "icons/flint-16.png", "32": "icons/flint-32.png" }
  },
  "icons": {
    "16": "icons/flint-16.png",
    "32": "icons/flint-32.png",
    "48": "icons/flint-48.png",
    "128": "icons/flint-128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "flint_trackers", "enabled": true, "path": "privacy/trackers.json" }
    ]
  }
}
