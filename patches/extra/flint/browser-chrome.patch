+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[ui::kColorFrameActive] = {kFrame};
+  mixer[ui::kColorFrameInactive] = {SkColorSetRGB(0x22, 0x23, 0x25)};
+  mixer[kColorToolbar] = {kToolbar};
+  mixer[kColorToolbarText] = {kText};
+  mixer[kColorToolbarButtonIcon] = {kQuietText};
