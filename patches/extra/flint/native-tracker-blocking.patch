 namespace {
 
+bool ShouldBlockFlintTracker(const net::URLRequest& request,
+                             mojom::RequestDestination destination,
+                             const GURL& target) {
+  if (destination == mojom::RequestDestination::kDocument ||
+      !target.SchemeIsHTTPOrHTTPS() ||
+      !base::FeatureList::IsEnabled(features::kFlintTrackerBlocking)) {
+    return false;
+  }
+
+  static constexpr auto domains = base::MakeFixedFlatSet<std::string_view>({
+      "adsrvr.org", "analytics.tiktok.com", "bat.bing.com", "clarity.ms",
+      "connect.facebook.net", "doubleclick.net", "google-analytics.com",
+      "googleadservices.com", "hotjar.com", "hotjar.io", "mouseflow.com",
+      "scorecardresearch.com", "snap.licdn.com",
+  });
+  std::string_view host = target.host();
+  if (host.ends_with('.')) {
+    host.remove_suffix(1);
+  }
+  while (!host.empty()) {
+    if (domains.contains(host)) {
+      const auto& top_frame = request.isolation_info().top_frame_origin();
+      const auto& origin = top_frame.has_value() ? top_frame : request.initiator();
+      return origin && !origin->opaque() &&
+             !net::SchemefulSite::IsSameSite(*origin, url::Origin::Create(target));
+    }
+    size_t dot = host.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    host.remove_prefix(dot + 1);
+  }
+  return false;
+}
+
