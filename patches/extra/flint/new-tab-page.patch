 NewTabPageThirdPartyHandler::~NewTabPageThirdPartyHandler() {
   ThemeServiceFactory::GetForProfile(profile_)->RemoveObserver(this);
+}
+
+void NewTabPageThirdPartyHandler::Search(const std::string& query,
+                                         SearchCallback callback) {
+  auto* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  const TemplateURL* provider = service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!provider || query.empty() || query.size() > 65536 ||
+      !provider->url_ref().SupportsReplacement(service->search_terms_data())) {
+    std::move(callback).Run(false);
+    return;
+  }
+  TemplateURLRef::SearchTermsArgs terms(base::UTF8ToUTF16(query));
+  TemplateURLRef::PostContent post;
+  GURL destination(provider->url_ref().ReplaceSearchTerms(
+      terms, service->search_terms_data(), &post));
+  if (!destination.is_valid() || !destination.SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  content::NavigationController::LoadURLParams params(destination);
+  params.transition_type = ui::PAGE_TRANSITION_GENERATED;
+  if (!post.second.empty()) {
+    params.load_type = content::NavigationController::LOAD_TYPE_HTTP_POST;
+    params.post_data = network::ResourceRequestBody::CreateFromCopyOfBytes(
+        base::as_byte_span(post.second));
+    params.post_content_type = post.first;
+  }
+  std::move(callback).Run(true);
+  web_contents_->GetController().LoadURLWithParams(params);
+}
+
+void NewTabPageThirdPartyHandler::GetSearchProviderName(
+    GetSearchProviderNameCallback callback) {
+  auto* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  std::move(callback).Run(
+      service ? base::UTF16ToUTF8(GetDefaultSearchEngineName(service)) : "");
 }
 
